# Copy to .env and fill in. Never commit .env.

# --- Chat gateways (at least one required for `bun run dev`) ---
# Both may run at once: a user who links the two accounts reaches the same
# authorization record — one daily cap, one spend ledger — from either.
# Telegram bot token from @BotFather.
TELEGRAM_BOT_TOKEN=
# Discord bot token (Developer Portal → Bot). Ward is DM-only, so it needs no
# privileged Message Content intent — invite it with the bot scope only.
DISCORD_BOT_TOKEN=

# --- Agent LLM (Phase 2+) ---
# OpenAI — the agent model is gpt-4o-mini. Without a key the agent node falls back
# to a deterministic recall of the authorization context.
OPENAI_API_KEY=
WARD_AGENT_MODEL=gpt-4o-mini
WARD_GUARD_MODEL=gpt-4o-mini

# development | production | test
NODE_ENV=development

# --- Sibyl Memory (the persistence layer) — see SIBYL-MEMORY.md ---
# sibyl-mcp (default) = the real, judged path. Needs `pipx install 'sibyl-memory-cli[mcp]'`
#   (Python 3.10+); runs unactivated locally, `sibyl init` unlocks the Pro tier.
# fs = hermetic JSON files for offline dev / tests.
SIBYL_MEMORY_MODE=sibyl-mcp
# Overrides for the sibyl-memory-mcp server (all optional):
SIBYL_MEMORY_MCP_COMMAND=sibyl-memory-mcp
SIBYL_MEMORY_DB=
SIBYL_CREDENTIALS=
# Any value = forward the MCP server's stderr:
SIBYL_MEMORY_MCP_DEBUG=
# Root dir for the `fs` backend only (default: ./memory):
WARD_MEMORY_DIR=

# --- Base / chain (Phase 4+) ---
# base-sepolia (default) or base
BASE_NETWORK=base-sepolia
BASE_RPC_URL=

# --- Coinbase CDP wallets (Phase 4+) ---
# All three present → the real CDP wallet provider; absent → the deterministic stub.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
CDP_WALLET_SECRET=
# Coinbase geoblocks some regions. Set an HTTP(S) proxy in a blocked region for
# LOCAL DEV ONLY — only *.coinbase.com traffic is routed through it (see src/net.ts).
# Leave unset on a deploy in a non-blocked region (e.g. Railway).
CDP_PROXY_URL=

# --- x402 execution (Phase 5+) ---
X402_FACILITATOR_URL=
# Override the static endpoint catalog (default: memory/catalog/x402-catalog.json):
WARD_X402_CATALOG=
# Spends at or below this auto-execute without a confirmation (default 0 = always confirm):
WARD_AUTO_APPROVE_USD=0

# --- Virtuals ACP (Phase 6+) — see ACP.md ---
# stub (default, simulated counterparty) or virtuals (real, go/no-go spike):
ACP_MODE=stub
# From the agent's Wallet tab at https://app.virtuals.io/acp/new.
# Escrow draws on ACP_WALLET_ADDRESS, so each job forwards the user's pulled
# budget to it and refunds the remainder — it is never a Ward-funded float.
ACP_WALLET_ADDRESS=
ACP_WALLET_ID=
# Signers panel → "+ Add Key" (shown once).
ACP_SIGNER_KEY=
# Optional.
ACP_BUILDER_CODE=
# Default escrow budget for an ACP job, in USD:
WARD_ACP_BUDGET_USD=0.5

# Optional: pin the ACP counterparty to one wallet. Unset = hire whichever agent
# Virtuals ranks first for "token risk" (the ACP.md default: prefer an independent
# agent). Set it to reach your own seller in counterparty/ reproducibly.
ACP_COUNTERPARTY_WALLET=
