# This agent's OWN Virtuals ACP credentials — a second registration, not Ward's.
# https://app.virtuals.io/acp/new → the agent's Wallet tab.

# The agent wallet's EVM address, shown at the top of the Wallet tab (0x…).
ACP_WALLET_ADDRESS=
# "EVM WALLET ID" on the Wallet tab — NOT the Solana one.
ACP_WALLET_ID=
# Signers panel → "+ Add Key" → the private key it shows (shown once).
ACP_SIGNER_KEY=
# Optional; the SDK accepts it as an attribution tag.
ACP_BUILDER_CODE=
